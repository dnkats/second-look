{
  "name": "second-look",
  "displayName": "Second Look",
  "description": "Review what your coding agent changed, change by change: accept, reject, edit, leave comments for the agent, and finish when you're done.",
  "version": "0.2.0",
  "publisher": "dnkats",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnkats/second-look"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "review",
    "code review",
    "agent",
    "claude",
    "codex",
    "diff",
    "comments"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node --test test/unit/*.test.mjs",
    "test:vscode": "npm run build && node test/vscode/run.mjs",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  },
  "contributes": {
    "views": {
      "secondLook": [
        {
          "id": "secondLook.view",
          "name": "Second Look",
          "icon": "media/review.svg",
          "contextualTitle": "Second Look"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "secondLook.view",
        "contents": "The review is paused: no highlights, links or counts, and what you accepted is kept.\n[Resume Review](command:secondLook.resume)",
        "when": "secondLook.paused"
      },
      {
        "view": "secondLook.view",
        "contents": "Open a folder that is a git repository to review the changes in it.",
        "when": "secondLook.state == noRepo && !secondLook.paused"
      },
      {
        "view": "secondLook.view",
        "contents": "Looking for changes…",
        "when": "secondLook.state == loading && !secondLook.paused"
      },
      {
        "view": "secondLook.view",
        "contents": "Review what you or an agent changed in this repository, change by change: accept, reject, leave comments. Nothing shows, and Second Look writes nothing into .git, until you start.\n[Start Review](command:secondLook.start)\nStart Review shows the changes on this branch since it left main; on main, the commits not pushed yet and what is not committed. To start somewhere else: [Review From…](command:secondLook.reviewFrom)",
        "when": "secondLook.state == off && !secondLook.paused"
      },
      {
        "view": "secondLook.view",
        "contents": "Nothing to review. Changes that you or an agent make in this repository show up here.\n[Review From…](command:secondLook.reviewFrom)",
        "when": "secondLook.state == clean && !secondLook.paused"
      },
      {
        "view": "secondLook.view",
        "contents": "Check out a branch to review the changes on it.",
        "when": "secondLook.state == detached && !secondLook.paused"
      },
      {
        "view": "secondLook.view",
        "contents": "A terminal review (git review) is open in this checkout.\n[Take It Over](command:secondLook.takeOverTerminal)",
        "when": "secondLook.state == terminal && !secondLook.paused"
      },
      {
        "view": "secondLook.view",
        "contents": "Something went wrong while reading the repository.\n[Refresh](command:secondLook.refresh)",
        "when": "secondLook.state == error && !secondLook.paused"
      }
    ],
    "commands": [
      {
        "command": "secondLook.refresh",
        "title": "Refresh",
        "category": "Second Look",
        "icon": "$(refresh)"
      },
      {
        "command": "secondLook.openAll",
        "title": "Open All Changes to Review",
        "category": "Second Look",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "secondLook.finish",
        "title": "Finish Review",
        "category": "Second Look",
        "icon": "$(check-all)"
      },
      {
        "command": "secondLook.undo",
        "title": "Undo Last Accept or Reject",
        "category": "Second Look",
        "icon": "$(discard)"
      },
      {
        "command": "secondLook.start",
        "title": "Start Review",
        "category": "Second Look",
        "icon": "$(play)"
      },
      {
        "command": "secondLook.reviewFrom",
        "title": "Review From…",
        "category": "Second Look",
        "icon": "$(history)"
      },
      {
        "command": "secondLook.pause",
        "title": "Pause Review",
        "category": "Second Look",
        "icon": "$(debug-pause)"
      },
      {
        "command": "secondLook.resume",
        "title": "Resume Review",
        "category": "Second Look",
        "icon": "$(debug-start)"
      },
      {
        "command": "secondLook.acceptAll",
        "title": "Accept All Changes",
        "category": "Second Look",
        "icon": "$(check-all)"
      },
      {
        "command": "secondLook.rejectAll",
        "title": "Reject All Changes",
        "category": "Second Look",
        "icon": "$(close-all)"
      },
      {
        "command": "secondLook.accept",
        "title": "Accept",
        "category": "Second Look",
        "icon": "$(check)"
      },
      {
        "command": "secondLook.reject",
        "title": "Reject",
        "category": "Second Look",
        "icon": "$(close)"
      },
      {
        "command": "secondLook.unaccept",
        "title": "Review Again",
        "category": "Second Look",
        "icon": "$(reply)"
      },
      {
        "command": "secondLook.openChange",
        "title": "Open Change",
        "category": "Second Look",
        "icon": "$(go-to-file)"
      },
      {
        "command": "secondLook.openAccepted",
        "title": "Open Accepted Change",
        "category": "Second Look",
        "icon": "$(go-to-file)"
      },
      {
        "command": "secondLook.openInEditor",
        "title": "Open File",
        "category": "Second Look",
        "icon": "$(go-to-file)"
      },
      {
        "command": "secondLook.openInDiff",
        "title": "Open Diff",
        "category": "Second Look",
        "icon": "$(diff)"
      },
      {
        "command": "secondLook.acceptBlock",
        "title": "Accept Block",
        "category": "Second Look",
        "icon": "$(check)"
      },
      {
        "command": "secondLook.acceptSelection",
        "title": "Accept Selection",
        "category": "Second Look",
        "icon": "$(check)"
      },
      {
        "command": "secondLook.rejectBlock",
        "title": "Reject Block",
        "category": "Second Look",
        "icon": "$(close)"
      },
      {
        "command": "secondLook.acceptAtCursor",
        "title": "Accept Change at Cursor",
        "category": "Second Look",
        "icon": "$(check)"
      },
      {
        "command": "secondLook.rejectAtCursor",
        "title": "Reject Change at Cursor",
        "category": "Second Look",
        "icon": "$(close)"
      },
      {
        "command": "secondLook.nextChange",
        "title": "Next Change to Review",
        "category": "Second Look",
        "icon": "$(arrow-circle-down)"
      },
      {
        "command": "secondLook.previousChange",
        "title": "Previous Change to Review",
        "category": "Second Look",
        "icon": "$(arrow-circle-up)"
      },
      {
        "command": "secondLook.reviewThisFile",
        "title": "Review Changes in This File",
        "category": "Second Look",
        "icon": "$(diff)"
      },
      {
        "command": "secondLook.takeOverTerminal",
        "title": "Take Over Terminal Review",
        "category": "Second Look",
        "icon": "$(terminal)"
      },
      {
        "command": "secondLook.installSkill",
        "title": "Install Agent Skill…",
        "category": "Second Look",
        "icon": "$(hubot)"
      },
      {
        "command": "secondLook.hideDiffLinks",
        "title": "Hide CodeLens Links in Diffs",
        "category": "Second Look"
      },
      {
        "command": "secondLook.showDiffLinks",
        "title": "Show CodeLens Links in Diffs",
        "category": "Second Look"
      },
      {
        "command": "secondLook.copyComments",
        "title": "Copy Open Comments as Prompt",
        "category": "Second Look",
        "icon": "$(copy)"
      },
      {
        "command": "secondLook.comment.create",
        "title": "Add Comment",
        "category": "Second Look"
      },
      {
        "command": "secondLook.comment.reply",
        "title": "Reply",
        "category": "Second Look"
      },
      {
        "command": "secondLook.comment.resolve",
        "title": "Resolve",
        "category": "Second Look",
        "icon": "$(check)"
      },
      {
        "command": "secondLook.comment.reopen",
        "title": "Reopen",
        "category": "Second Look",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "secondLook.comment.delete",
        "title": "Delete Thread",
        "category": "Second Look",
        "icon": "$(trash)"
      },
      {
        "command": "secondLook.comment.edit",
        "title": "Edit",
        "category": "Second Look",
        "icon": "$(edit)"
      },
      {
        "command": "secondLook.comment.save",
        "title": "Save",
        "category": "Second Look"
      },
      {
        "command": "secondLook.comment.cancel",
        "title": "Cancel",
        "category": "Second Look"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "secondLook.accept",
          "when": "false"
        },
        {
          "command": "secondLook.reject",
          "when": "false"
        },
        {
          "command": "secondLook.unaccept",
          "when": "false"
        },
        {
          "command": "secondLook.openChange",
          "when": "false"
        },
        {
          "command": "secondLook.openAccepted",
          "when": "false"
        },
        {
          "command": "secondLook.openInEditor",
          "when": "false"
        },
        {
          "command": "secondLook.hideDiffLinks",
          "when": "config.diffEditor.codeLens"
        },
        {
          "command": "secondLook.showDiffLinks",
          "when": "!config.diffEditor.codeLens"
        },
        {
          "command": "secondLook.openInDiff",
          "when": "false"
        },
        {
          "command": "secondLook.comment.create",
          "when": "false"
        },
        {
          "command": "secondLook.comment.reply",
          "when": "false"
        },
        {
          "command": "secondLook.comment.resolve",
          "when": "false"
        },
        {
          "command": "secondLook.comment.reopen",
          "when": "false"
        },
        {
          "command": "secondLook.comment.delete",
          "when": "false"
        },
        {
          "command": "secondLook.comment.edit",
          "when": "false"
        },
        {
          "command": "secondLook.comment.save",
          "when": "false"
        },
        {
          "command": "secondLook.comment.cancel",
          "when": "false"
        },
        {
          "command": "secondLook.acceptAtCursor",
          "when": "secondLook.activeFileHasPending || secondLook.activeIsReviewDiff"
        },
        {
          "command": "secondLook.rejectAtCursor",
          "when": "secondLook.activeFileHasPending || secondLook.activeIsReviewDiff"
        },
        {
          "command": "secondLook.takeOverTerminal",
          "when": "secondLook.state == terminal || secondLook.state == multi"
        },
        {
          "command": "secondLook.acceptBlock",
          "when": "false"
        },
        {
          "command": "secondLook.acceptSelection",
          "when": "false"
        },
        {
          "command": "secondLook.rejectBlock",
          "when": "false"
        },
        {
          "command": "secondLook.start",
          "when": "secondLook.canStart"
        },
        {
          "command": "secondLook.pause",
          "when": "!secondLook.paused"
        },
        {
          "command": "secondLook.resume",
          "when": "secondLook.paused"
        }
      ],
      "view/title": [
        {
          "command": "secondLook.resume",
          "when": "view == secondLook.view && secondLook.paused",
          "group": "navigation@0"
        },
        {
          "command": "secondLook.openAll",
          "when": "view == secondLook.view && secondLook.hasPending",
          "group": "navigation@1"
        },
        {
          "command": "secondLook.undo",
          "when": "view == secondLook.view && secondLook.canUndo",
          "group": "navigation@2"
        },
        {
          "command": "secondLook.finish",
          "when": "view == secondLook.view && secondLook.hasReview",
          "group": "navigation@3"
        },
        {
          "command": "secondLook.refresh",
          "when": "view == secondLook.view",
          "group": "navigation@4"
        },
        {
          "command": "secondLook.start",
          "when": "view == secondLook.view && secondLook.canStart",
          "group": "1_review@0"
        },
        {
          "command": "secondLook.reviewFrom",
          "when": "view == secondLook.view",
          "group": "1_review@1"
        },
        {
          "command": "secondLook.acceptAll",
          "when": "view == secondLook.view && secondLook.hasPending",
          "group": "1_review@2"
        },
        {
          "command": "secondLook.rejectAll",
          "when": "view == secondLook.view && secondLook.hasPending",
          "group": "1_review@3"
        },
        {
          "command": "secondLook.copyComments",
          "when": "view == secondLook.view",
          "group": "2_agent@1"
        },
        {
          "command": "secondLook.installSkill",
          "when": "view == secondLook.view",
          "group": "2_agent@2"
        },
        {
          "command": "secondLook.hideDiffLinks",
          "when": "view == secondLook.view && config.diffEditor.codeLens",
          "group": "3_show@1"
        },
        {
          "command": "secondLook.showDiffLinks",
          "when": "view == secondLook.view && !config.diffEditor.codeLens",
          "group": "3_show@1"
        },
        {
          "command": "secondLook.pause",
          "when": "view == secondLook.view && !secondLook.paused && secondLook.state != off",
          "group": "4_pause@1"
        }
      ],
      "view/item/context": [
        {
          "command": "secondLook.openInEditor",
          "when": "view == secondLook.view && viewItem =~ /^pending(File|Hunk)$/ && config.secondLook.openIn != editor",
          "group": "inline@0"
        },
        {
          "command": "secondLook.openInDiff",
          "when": "view == secondLook.view && viewItem =~ /^pending(File|Hunk)$/ && config.secondLook.openIn == editor",
          "group": "inline@0"
        },
        {
          "command": "secondLook.accept",
          "when": "view == secondLook.view && viewItem =~ /^pending(File|Hunk)$/",
          "group": "inline@1"
        },
        {
          "command": "secondLook.reject",
          "when": "view == secondLook.view && viewItem =~ /^pending(File|Hunk)$/",
          "group": "inline@2"
        },
        {
          "command": "secondLook.unaccept",
          "when": "view == secondLook.view && viewItem =~ /^accepted(File|Hunk)$/",
          "group": "inline@1"
        },
        {
          "command": "secondLook.openAll",
          "when": "view == secondLook.view && viewItem == pendingGroup",
          "group": "inline@1"
        },
        {
          "command": "secondLook.accept",
          "when": "view == secondLook.view && viewItem =~ /^pending(File|Hunk)$/",
          "group": "1_review@1"
        },
        {
          "command": "secondLook.reject",
          "when": "view == secondLook.view && viewItem =~ /^pending(File|Hunk)$/",
          "group": "1_review@2"
        },
        {
          "command": "secondLook.unaccept",
          "when": "view == secondLook.view && viewItem =~ /^accepted(File|Hunk)$/",
          "group": "1_review@1"
        },
        {
          "command": "secondLook.openChange",
          "when": "view == secondLook.view && viewItem =~ /^pending(File|Hunk)$/",
          "group": "2_open@1"
        },
        {
          "command": "secondLook.openInEditor",
          "when": "view == secondLook.view && viewItem =~ /^pending(File|Hunk)$/ && config.secondLook.openIn != editor",
          "group": "2_open@2"
        },
        {
          "command": "secondLook.openInDiff",
          "when": "view == secondLook.view && viewItem =~ /^pending(File|Hunk)$/ && config.secondLook.openIn == editor",
          "group": "2_open@2"
        },
        {
          "command": "secondLook.openAccepted",
          "when": "view == secondLook.view && viewItem =~ /^accepted(File|Hunk)$/",
          "group": "2_open@1"
        }
      ],
      "editor/title": [
        {
          "command": "secondLook.previousChange",
          "when": "secondLook.activeIsReviewDiff || (secondLook.activeFileHasPending && !isInDiffEditor)",
          "group": "navigation@-2"
        },
        {
          "command": "secondLook.nextChange",
          "when": "secondLook.activeIsReviewDiff || (secondLook.activeFileHasPending && !isInDiffEditor)",
          "group": "navigation@-1"
        },
        {
          "command": "secondLook.reviewThisFile",
          "when": "secondLook.activeFileHasPending && !isInDiffEditor",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "secondLook.acceptAtCursor",
          "when": "secondLook.activeFileHasPending || secondLook.activeIsReviewDiff",
          "group": "1_secondLook@1"
        },
        {
          "command": "secondLook.rejectAtCursor",
          "when": "secondLook.activeFileHasPending || secondLook.activeIsReviewDiff",
          "group": "1_secondLook@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "secondLook.comment.create",
          "when": "commentController == secondLook && commentThreadIsEmpty",
          "group": "inline"
        },
        {
          "command": "secondLook.comment.reply",
          "when": "commentController == secondLook && !commentThreadIsEmpty",
          "group": "inline"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "secondLook.comment.resolve",
          "when": "commentController == secondLook && commentThread == open",
          "group": "inline@1"
        },
        {
          "command": "secondLook.comment.reopen",
          "when": "commentController == secondLook && commentThread == resolved",
          "group": "inline@1"
        },
        {
          "command": "secondLook.comment.delete",
          "when": "commentController == secondLook && !commentThreadIsEmpty",
          "group": "inline@2"
        }
      ],
      "comments/comment/title": [
        {
          "command": "secondLook.comment.edit",
          "when": "commentController == secondLook && comment == user",
          "group": "inline"
        }
      ],
      "comments/comment/context": [
        {
          "command": "secondLook.comment.cancel",
          "when": "commentController == secondLook",
          "group": "inline@1"
        },
        {
          "command": "secondLook.comment.save",
          "when": "commentController == secondLook",
          "group": "inline@2"
        }
      ],
      "diffEditor/gutter/hunk": [
        {
          "command": "secondLook.acceptBlock",
          "group": "primary@5",
          "when": "diffEditorOriginalUri =~ /^second-look:/ && !secondLook.paused"
        },
        {
          "command": "secondLook.rejectBlock",
          "group": "primary@5",
          "when": "diffEditorOriginalUri =~ /^second-look:/ && !secondLook.paused"
        }
      ],
      "diffEditor/gutter/selection": [
        {
          "command": "secondLook.acceptSelection",
          "group": "primary@5",
          "when": "diffEditorOriginalUri =~ /^second-look:/ && !secondLook.paused"
        }
      ]
    },
    "keybindings": [
      {
        "command": "secondLook.acceptAtCursor",
        "key": "alt+y",
        "when": "editorTextFocus && (secondLook.activeFileHasPending || secondLook.activeIsReviewDiff)"
      },
      {
        "command": "secondLook.rejectAtCursor",
        "key": "alt+n",
        "when": "editorTextFocus && (secondLook.activeFileHasPending || secondLook.activeIsReviewDiff)"
      },
      {
        "command": "secondLook.nextChange",
        "key": "alt+f5",
        "when": "editorTextFocus && (secondLook.activeIsReviewDiff || (secondLook.activeFileHasPending && !isInDiffEditor))"
      },
      {
        "command": "secondLook.previousChange",
        "key": "shift+alt+f5",
        "when": "editorTextFocus && (secondLook.activeIsReviewDiff || (secondLook.activeFileHasPending && !isInDiffEditor))"
      }
    ],
    "configuration": {
      "title": "Second Look",
      "properties": {
        "secondLook.finish.commitEdits": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "default": "ask",
          "enumDescriptions": [
            "Ask when finishing a review.",
            "Commit everything uncommitted as one \"Review edits\" commit.",
            "Leave uncommitted changes as they are."
          ],
          "description": "What Finish Review does with changes that are not committed yet."
        },
        "secondLook.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show Accept and Reject above each change to review, in the editor and in review diffs. Second Look turns diffEditor.codeLens on by default so they show in diffs (links of other extensions too); review diffs go without them once Second Look knows that the diff's gutter has Accept Block."
        },
        "secondLook.codeLensBelow": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "Also show Accept and Reject below changes of at least this many lines; 0 turns it off."
        },
        "secondLook.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the number of changes to review in the status bar."
        },
        "secondLook.highlightChanges": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the lines still to review in the editor, with the text they replaced on hover."
        },
        "secondLook.openIn": {
          "type": "string",
          "enum": [
            "diff",
            "editor"
          ],
          "default": "diff",
          "enumDescriptions": [
            "A diff of the accepted text against the file as it is now.",
            "The file itself, with the changes highlighted: a dashed line where text was removed, the old text on hover."
          ],
          "description": "Where a click on a file or change in the list opens it, and where the next change continues into another file (from a review diff it stays in diffs). Deleted and binary files always open in a diff."
        }
      }
    },
    "chatSkills": [
      {
        "path": "./skill/review-comments/SKILL.md"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "secondLook",
          "title": "Second Look",
          "icon": "media/review.svg"
        }
      ]
    },
    "configurationDefaults": {
      "diffEditor.codeLens": true
    }
  },
  "enabledApiProposals": [
    "contribDiffEditorGutterToolBarMenus"
  ]
}
